DATABASE_URL=sqlite:///./jobs.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=15

# SEC EDGAR fair-use policy requires a real contact email in the User-Agent
# header on every API call. Without one, requests may be rate-limited or
# 403'd. Substitute your address.
EDGAR_CONTACT_EMAIL=you@example.com

# USAJobs Search API. Free key: register at https://developer.usajobs.gov.
# User-Agent must be a real contact email per their docs. With these unset,
# the USAJobs adapter logs a warning and skips its companies (no error).
USAJOBS_API_KEY=
USAJOBS_CONTACT_EMAIL=you@example.com
